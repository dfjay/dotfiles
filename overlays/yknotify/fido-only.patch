+// FIDO Alliance HID usage page (0xF1D0), declared by the CTAP HID interface of
+// every FIDO2 security key. Other USB HID devices (touchscreens, mice, gamepads)
+// also log "open by IOHIDLibUserClient" + "startQueue" and must not trigger FIDO2.
+const fidoUsagePage = "61904"
+
+// isFIDODevice reports whether the HID device with the given registry ID
+// (e.g. "0x100000c81") is a FIDO authenticator, according to ioreg.
+func isFIDODevice(registryID string) bool {
+	out, err := exec.Command("ioreg", "-r", "-c", "AppleUserUSBHostHIDDevice", "-w0").Output()
+	if err != nil {
+		return true // fail open: keep upstream behaviour
+	}
+	inDevice := false
+	for _, line := range strings.Split(string(out), "\n") {
+		if strings.HasPrefix(line, "+-o ") {
+			inDevice = strings.Contains(line, "id "+registryID+",")
+		} else if inDevice && strings.Contains(line, `"PrimaryUsagePage" = `) {
+			return strings.HasSuffix(strings.TrimSpace(line), "= "+fidoUsagePage)
+		}
+	}
+	return false
+}
